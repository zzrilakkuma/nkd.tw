# ===== 網域 / 憑證 =====
SITE_DOMAIN=nkd.tw
API_DOMAIN=api.nkd.tw
ACME_EMAIL=you@example.com

# ===== PostgreSQL（容器內部用，不對外）=====
POSTGRES_VERSION=16
POSTGRES_USER=hookah
POSTGRES_PASSWORD=change-me-openssl-rand-hex-24
POSTGRES_DB=hookah_store

# ===== 後端 =====
# 產生方式：openssl rand -hex 32
# 沿用 Zeabur 上的值可讓現有登入不失效；若要換新 key，所有人需重新登入一次
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
EXPIRY_SWEEP_INTERVAL_SECONDS=600

# Email 通知（Resend）；留空則停用寄信
RESEND_API_KEY=
MAIL_FROM=NKD 訂單通知 <orders@nkd.tw>
MAIL_REPLY_TO=
ADMIN_NOTIFY_EMAIL=

# 運費預設值（可省略，使用程式預設）
# SHIPPING_FEE_HOME_DELIVERY=120
# SHIPPING_FEE_CVS_711=60
# SHIPPING_FEE_SELF_PICKUP=0

# DATABASE_URL 與 FRONTEND_URL 由 docker-compose.prod.yml 依上面的值組出來，不用另外設
